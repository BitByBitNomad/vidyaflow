# Root Environment Variables Template for VidyaFlow Platform (Engineered by BitByBitNomad)

# Database & Cache (Used in Docker Compose or Local Dev)
DATABASE_URL=postgresql://your_db_user:your_db_password@your_host:5432/your_database?schema=public
REDIS_URL=redis://localhost:6379

# Backend Configuration
PORT=4000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_key_change_in_production

# Modern Supabase Configuration (Publishable & Secret Keys)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
