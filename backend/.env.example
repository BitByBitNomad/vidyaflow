# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Supabase PostgreSQL Connection URI)
DATABASE_URL="postgresql://your_db_user:your_db_password@your_host:5432/your_database?schema=public"

# Redis Cache & Leaderboard (Sorted Sets)
REDIS_URL="redis://localhost:6379"

# Modern Supabase Configuration (Publishable & Secret Key)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
SUPABASE_SECRET_KEY="sb_secret_your_key_here"

# Internal Token Security & Fallback
JWT_SECRET="your_jwt_secret_key_change_in_production"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
